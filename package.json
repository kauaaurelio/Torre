{
  "name": "torre",
  "version": "0.4.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "worker": "tsx worker/index.ts",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/worker.cjs",
    "app:dev": "npm run build:worker && cross-env TORRE_MODE=dev electron .",
    "app": "npm run build && npm run build:worker && electron .",
    "dist": "npm run build && npm run build:worker && electron-builder",
    "dist:publish": "npm run build && npm run build:worker && electron-builder --publish always",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "build": {
    "appId": "com.torre.app",
    "productName": "Torre",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!data/**",
      "!.baileys/**",
      "!worker/**",
      "!**/*.log",
      "!**/*.tsbuildinfo",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kauaaurelio",
        "repo": "torre",
        "private": false,
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Torre-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Torre",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "baileys": "^6.7.23",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "next": "^15.1.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "png-to-ico": "^3.0.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
